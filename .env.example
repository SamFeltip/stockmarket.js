# This repository only: npx convex dev --once writes the values to .env.local.
# See ENVIRONMENT.md. Do not copy secrets or env files from the workspace root.
# Public browser backend URL (never put secrets under VITE_*).
VITE_CONVEX_URL=
# CLI-managed development deployment selection.
CONVEX_DEPLOYMENT=
# JWT_PRIVATE_KEY, JWKS and NPC_DISABLE_NEW_GAMES belong in the Convex
# deployment environment, not this file. CONVEX_SITE_URL is supplied by Convex.
