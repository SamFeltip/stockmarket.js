{
    "name": "stockmarket-convex",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "convex dev --start 'npm run dev:frontend'",
        "dev:frontend": "vite --host 0.0.0.0",
        "backend": "convex dev",
        "build": "tsc --noEmit && npm run typecheck:npc && vite build",
        "typecheck:npc": "tsc --noEmit -p packages/npc-engine/tsconfig.json",
        "preview": "vite preview --host 127.0.0.1",
        "test": "vitest run",
        "deploy": "npm run check && npm run deploy:backend && npm run deploy:frontend",
        "deploy:backend": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name VITE_CONVEX_URL",
        "deploy:frontend": "npx wrangler pages deploy dist --project-name stockmarket-convex --branch main",
        "simulate:npcs": "node scripts/simulate-npcs.mjs",
        "assets:check": "node scripts/check-assets.mjs",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "check": "npm run lint && npm test && npm run build && npm run assets:check"
    },
    "dependencies": {
        "@auth/core": "^0.41.3",
        "@convex-dev/auth": "latest",
        "convex": "latest",
        "react": "latest",
        "react-dom": "latest",
        "react-is": "^19.3.1",
        "react-router-dom": "latest",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@eslint/css": "^2.0.1",
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "latest",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@vitejs/plugin-react": "latest",
        "convex-test": "latest",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^62.0.0",
        "globals": "^17.13.0",
        "typescript": "latest",
        "typescript-eslint": "^8.71.2",
        "vite": "latest",
        "vitest": "latest"
    }
}
